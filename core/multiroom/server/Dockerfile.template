FROM debian:trixie-slim AS build

WORKDIR /usr/src

# Install build dependencies and CA certificates
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        cmake \
        git \
        curl \
        libpulse-dev \
        libasound2-dev \
        libvorbis-dev \
        libflac-dev \
        libopus-dev \
        libsoxr-dev \
        libavahi-client-dev \
        libssl-dev \
        libfmt-dev \
        libspdlog-dev \
        libexpat1-dev \
        libboost-all-dev \
        wget && \
    rm -rf /var/lib/apt/lists/*

# Build and install Snapcast server: dynamically resolve the latest stable
# release tag from GitHub so this never needs manual version bumps.
RUN SNAPCAST_VERSION=$(curl -sL https://api.github.com/repos/badaix/snapcast/releases/latest | \
      grep -oP '"tag_name":\s*"\K[^"]+') && \
    echo "Building snapcast server ${SNAPCAST_VERSION}" && \
    git clone --depth 1 --branch "${SNAPCAST_VERSION}" https://github.com/badaix/snapcast.git && \
    cd snapcast && \
    mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc) && \
    make install

# --- Final image ---
FROM debian:trixie-slim

WORKDIR /usr/src

# Install only runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpulse0 \
        pulseaudio \
        libasound2t64 \
        libvorbis0a \
        libflac14 \
        libopus0 \
        libsoxr0 \
        libavahi-client3 \
        avahi-daemon \
        libssl3t64 \
        libfmt10 \
        libspdlog1.15 \
        libexpat1 \
        libboost-system1.88.0 \
        curl \
        iproute2 && \
    rm -rf /var/lib/apt/lists/*

# Copy installed binaries and libraries from build stage
COPY --from=build /usr/local/bin/snapserver /usr/bin/snapserver
COPY --from=build /usr/local/share/snapserver /usr/local/share/snapserver

ENV PULSE_SERVER=tcp:audio:4317
ENV PULSE_SOURCE=snapcast.monitor

# Create PulseAudio config directory
RUN mkdir -p /etc/pulse

COPY snapserver.conf /etc/snapserver.conf
COPY start.sh .

CMD [ "/bin/bash", "/usr/src/start.sh" ]
