FROM debian:trixie-slim

WORKDIR /usr/src

# PulseAudio server address (provided by the core audio service)
ENV PULSE_SERVER=tcp:localhost:4317

# Install dependencies:
# - python3 + venv: to run plex-mpv-shim
# - mpv: media player used by plex-mpv-shim for audio decoding (brings in libmpv as dependency)
# - libasound2 + plugins + libpulse0: ALSA → PulseAudio audio bridge
# - curl, ca-certificates, uuid-runtime: used in start.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    uuid-runtime \
    python3 \
    python3-venv \
    mpv \
    libasound2t64 \
    libasound2-plugins \
    libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# Route ALSA audio through PulseAudio (same bridge used by AirPlay/Tidal plugins)
RUN printf 'pcm.!default {\n\
    type pulse\n\
    server "tcp:localhost:4317"\n\
}\n\
ctl.!default {\n\
    type pulse\n\
    server "tcp:localhost:4317"\n\
}\n' > /etc/asound.conf

# Install plex-mpv-shim in an isolated venv to avoid pip/system package conflicts.
# plex-mpv-shim is a lightweight Plex remote player (~50-80MB RAM) that registers
# as a cast target visible in the Plex app and Plex Web.
RUN python3 -m venv /opt/plex-venv && \
    /opt/plex-venv/bin/pip install --no-cache-dir plex-mpv-shim

# Persistent storage for config and player UUID
RUN mkdir -p /var/cache/plex-mpv-shim /root/.config/plex-mpv-shim

VOLUME /var/cache/plex-mpv-shim

COPY start.sh /usr/src/start.sh
RUN chmod +x /usr/src/start.sh

CMD ["/usr/src/start.sh"]
